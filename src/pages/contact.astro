---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact KDS Airdrop Hub"
  description="Contact KDS Airdrop Hub for feedback, corrections, content suggestions, and website-related inquiries."
  canonical="https://airdrop-hub.cryptoatlas.workers.dev/contact/"
>
  <main>
    <section class="article">
      <div class="container">
        <div class="article-header">
          <span class="coming-soon-badge">Contact</span>
          <h1>Contact KDS Airdrop Hub</h1>
          <p class="article-meta">
            Krisna Dwi Saputra · KDS Airdrop Hub
          </p>
        </div>

        <div class="article-body">
          <h2>Get in Touch</h2>
          <p>
            Have feedback about the website, found information that may need
            correction, or want to suggest a topic for a future guide?
          </p>

          <p>
            Contact details can be added here as the site's communication
            channel becomes available.
          </p>

          <h2>Corrections and Updates</h2>
          <p>
            Because crypto projects and campaigns can change quickly,
            information may become outdated. If you notice an inaccurate or
            outdated statement, please provide the relevant page and explain
            what should be reviewed.
          </p>

          <h2>Project Suggestions</h2>
          <p>
            Suggestions for projects or topics do not guarantee coverage or
            inclusion. Any potential opportunity should be evaluated
            independently before publication.
          </p>

          <h2>Important</h2>
          <p>
            KDS Airdrop Hub does not provide personalized financial or
            investment advice. Please do not send private keys, seed phrases,
            passwords, recovery phrases, or other sensitive wallet
            information.
          </p>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
