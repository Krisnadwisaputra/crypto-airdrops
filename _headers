# ============================================================
# Cloudflare Pages _headers
# Format:
#   /path
#     Header-Name: value
# ============================================================

# ---------- Security headers untuk semua halaman ----------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-8C6DJrAv96sMk06uPXginm4Xs6npl1b1Lj8hL0tbSUk=' 'sha256-Vskxi2KR1xMlJQBafjrve8us5a6L7s4cbNYSAGAvV6U=' 'sha256-cmHXNwOdlWoMb6VkT3nM/KN7DxsHt1p3cs2dWjWzaM0=' 'sha256-dsK3iB+VBhQcQnSgzbpuEfeyDwXatLna3ekWBOR5PMg=' 'sha256-jNm25xA5krbn0vXChjgNqaw73ZSsQIhKDyw912SHZhg=' 'sha256-qptSGYsN97EDgR7cGSTuWYVuSwuGL1PimVz8mOuiY+g=' 'sha256-zG27r4i8YwTPvhFwqcexhGL5xzrNf1I9m+exVOnnge0='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ---------- Cache CSS 1 tahun (immutable) ----------
/style.css
  Cache-Control: public, max-age=31536000, immutable

# ---------- Cache gambar / favicon (jika ada) ----------
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# ---------- Jangan cache HTML (selalu fresh) ----------
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------- Web manifest ----------
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# ---------- Sitemap & robots ----------
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400